cc_library_shared {
    name: "camera.tundra",
    vendor: true,
    relative_install_path: "hw",
    srcs: ["CameraWrapper.cpp"],
    header_libs: ["libhardware_headers"],
    shared_libs: [
        "libcamera_metadata",
        "liblog",
    ],
    cflags: [
        "-Wall",
        "-Werror",
    ],
}
