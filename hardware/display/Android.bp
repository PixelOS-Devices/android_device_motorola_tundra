cc_library_shared {
    name: "libsnapdragoncolor-manager",
    vendor: true,
    compile_multilib: "64",
    srcs: ["SnapdragonColorWrapper.cpp"],
    include_dirs: [
        "hardware/qcom-caf/sm8350/display/sdm/include",
        "vendor/qcom/opensource/commonsys-intf/display/include",
    ],
    shared_libs: [
        "libdl",
        "liblog",
    ],
    cflags: [
        "-Wall",
        "-Werror",
    ],
}
