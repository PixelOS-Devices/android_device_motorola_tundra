on fs
    wait /dev/block/platform/soc/${ro.boot.bootdevice}
    symlink /dev/block/platform/soc/${ro.boot.bootdevice} /dev/block/bootdevice

    # Load ADSP firmware for PMIC
    mkdir /firmware
    mount ext4 /dev/block/bootdevice/by-name/modem${ro.boot.slot_suffix} /firmware ro context=u:object_r:firmware_file:s0

on property:dev.mnt.blk.firmware=*
    write /sys/kernel/boot_adsp/boot 1
    wait /sys/class/power_supply/battery

on property:init.svc.fastbootd=running
    umount /firmware

on init
    setprop sys.usb.configfs 1

on property:ro.boot.usbcontroller=*
    setprop sys.usb.controller ${ro.boot.usbcontroller}
    write /sys/class/udc/${ro.boot.usbcontroller}/device/../mode peripheral

# The dwc3 UDC only registers once ucsi_glink has probed, after the ADSP is up
# (about 9 s into a recovery boot on 6.18), while fastbootd and adbd can set
# sys.usb.ffs.ready earlier. init.rc writes the UDC once and doesn't retry,
# so wait for it and bind the gadget here.
on property:sys.usb.config=fastboot && property:sys.usb.ffs.ready=1 && property:sys.usb.configfs=1
    wait /sys/class/udc/${sys.usb.controller} 30
    write /config/usb_gadget/g1/UDC ${sys.usb.controller}

on property:sys.usb.config=adb && property:sys.usb.ffs.ready=1 && property:sys.usb.configfs=1
    wait /sys/class/udc/${sys.usb.controller} 30
    write /config/usb_gadget/g1/UDC ${sys.usb.controller}

on property:sys.usb.config=sideload && property:sys.usb.ffs.ready=1 && property:sys.usb.configfs=1
    wait /sys/class/udc/${sys.usb.controller} 30
    write /config/usb_gadget/g1/UDC ${sys.usb.controller}
